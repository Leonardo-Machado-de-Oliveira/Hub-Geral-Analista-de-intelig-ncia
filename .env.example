# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Configuração do ERP Compy (Safeweb):
# Nenhuma credencial do ERP fica no servidor. Todas as chamadas ao Compy são feitas
# diretamente do navegador via CORS e configuradas pelo modal "Configurações" na página
# (salvas no localStorage do navegador na chave safetitulo_compy_config_v1).
